<Page
    x:Class="GetGUI.Views.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:GetGUI.Converters">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:IconSourceConverter x:Key="IconSourceConverter" />
    </Page.Resources>

    <Grid Padding="32" RowDefinitions="Auto,Auto,*">
        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton Icon="Back" Label="{x:Bind Loc.Back, Mode=OneWay}" Click="BackButton_Click" />
            <AppBarSeparator />
            <AppBarButton Icon="Download" Label="{x:Bind Loc.Install, Mode=OneWay}" Click="InstallButton_Click" />
            <AppBarButton Icon="Add" Label="{x:Bind Loc.AddToQueue, Mode=OneWay}" Click="AddToQueueButton_Click" />
            <AppBarButton Icon="Delete" Label="{x:Bind Loc.Uninstall, Mode=OneWay}" Click="UninstallButton_Click" />
        </CommandBar>

        <InfoBar
            Grid.Row="1"
            Margin="0,8,0,16"
            IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
            Severity="Informational"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="22">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                    <Border
                        Width="72"
                        Height="72"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <Grid>
                            <Image
                                Source="{x:Bind ViewModel.Application.IconUrl, Mode=OneWay, Converter={StaticResource IconSourceConverter}}"
                                Stretch="UniformToFill"
                                Visibility="{x:Bind ViewModel.Application.HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Application.Initials, Mode=OneWay}"
                                FontSize="22"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.Application.HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind ViewModel.Application.Name, Mode=OneWay}"
                            FontSize="30"
                            FontWeight="SemiBold"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            Text="{x:Bind ViewModel.Application.Id, Mode=OneWay}"
                            Opacity="0.72"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <ProgressRing
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Left"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Grid
                    ColumnDefinitions="180,*"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    RowSpacing="10"
                    ColumnSpacing="18">
                    <TextBlock Text="{x:Bind Loc.Publisher, Mode=OneWay}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Application.PublisherDisplay, Mode=OneWay}" TextWrapping="WrapWholeWords" />

                    <TextBlock Grid.Row="1" Text="Version" Opacity="0.7" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Application.Version, Mode=OneWay}" />

                    <TextBlock Grid.Row="2" Text="{x:Bind Loc.License, Mode=OneWay}" Opacity="0.7" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Application.License, Mode=OneWay}" TextWrapping="WrapWholeWords" />

                    <TextBlock Grid.Row="3" Text="{x:Bind Loc.Homepage, Mode=OneWay}" Opacity="0.7" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.Application.Homepage, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                </Grid>

                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind Loc.Description, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Application.DescriptionDisplay, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <StackPanel
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.HasLog, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{x:Bind Loc.Logs, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                    <TextBox
                        Text="{x:Bind ViewModel.OperationLog, Mode=OneWay}"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        MinHeight="180"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
