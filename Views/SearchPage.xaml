<Page
    x:Class="GetGUI.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:GetGUI.Converters"
    xmlns:models="using:GetGUI.Models">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:IconSourceConverter x:Key="IconSourceConverter" />
    </Page.Resources>

    <Grid Padding="32" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Center" Spacing="14">
            <TextBlock
                Text="GetGUI"
                FontSize="34"
                FontWeight="SemiBold"
                HorizontalAlignment="Center" />
            <AutoSuggestBox
                x:Name="SearchBox"
                MinWidth="420"
                MaxWidth="760"
                HorizontalAlignment="Stretch"
                PlaceholderText="Rechercher une application winget"
                QuerySubmitted="SearchBox_QuerySubmitted"
                TextChanged="SearchBox_TextChanged">
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            Margin="0,20,0,14"
            IsOpen="True"
            Severity="Informational"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

        <Grid Grid.Row="2">
            <GridView
                x:Name="ResultsGrid"
                ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                IsItemClickEnabled="True"
                ItemClick="ResultsGrid_ItemClick"
                SelectionMode="None">
                <GridView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromHorizontalOffset="18" FromVerticalOffset="12" />
                    </TransitionCollection>
                </GridView.ItemContainerTransitions>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:ApplicationPackage">
                        <Border
                            Width="330"
                            Height="260"
                            Margin="8"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border
                                        Width="44"
                                        Height="44"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                        CornerRadius="8">
                                        <Grid>
                                            <Image
                                                Source="{x:Bind IconUrl, Mode=OneWay, Converter={StaticResource IconSourceConverter}}"
                                                Stretch="UniformToFill"
                                                Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock
                                                Text="{x:Bind Initials, Mode=OneWay}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind Id, Mode=OneWay}"
                                            FontSize="12"
                                            Opacity="0.72"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="0,14,0,12" Spacing="6">
                                    <TextBlock
                                        Text="{x:Bind PublisherDisplay, Mode=OneWay}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Opacity="0.82"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind DescriptionDisplay, Mode=OneWay}"
                                        FontSize="13"
                                        MaxLines="5"
                                        TextTrimming="WordEllipsis"
                                        TextWrapping="WrapWholeWords" />
                                    <TextBlock
                                        Text="{x:Bind Version, Mode=OneWay}"
                                        FontSize="12"
                                        Opacity="0.64"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Button
                                        Content="Details"
                                        Click="DetailsButton_Click"
                                        Tag="{x:Bind}" />
                                    <Button
                                        Grid.Column="1"
                                        Click="AddToQueueButton_Click"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Ajouter a la file">
                                        <SymbolIcon Symbol="Add" />
                                    </Button>
                                    <Button
                                        Grid.Column="2"
                                        Click="InstallButton_Click"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Installer maintenant">
                                        <SymbolIcon Symbol="Download" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <ProgressRing
                Width="44"
                Height="44"
                IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <ScrollViewer
                Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                <StackPanel Spacing="16">
                    <TextBlock
                        Text="Populaires sur winget"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Visibility="{x:Bind ViewModel.HasPopularPackages, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <GridView
                        ItemsSource="{x:Bind ViewModel.PopularPackages, Mode=OneWay}"
                        IsItemClickEnabled="True"
                        ItemClick="ResultsGrid_ItemClick"
                        SelectionMode="None">
                        <GridView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="12" FromVerticalOffset="12" />
                            </TransitionCollection>
                        </GridView.ItemContainerTransitions>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:ApplicationPackage">
                                <Border
                                    Width="240"
                                    Height="170"
                                    Margin="8"
                                    Padding="14"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid RowDefinitions="Auto,*,Auto">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border
                                                Width="38"
                                                Height="38"
                                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                CornerRadius="8">
                                                <Grid>
                                                    <Image
                                                        Source="{x:Bind IconUrl, Mode=OneWay, Converter={StaticResource IconSourceConverter}}"
                                                        Stretch="UniformToFill"
                                                        Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock
                                                        Text="{x:Bind Initials, Mode=OneWay}"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock
                                                    Text="{x:Bind Name, Mode=OneWay}"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{x:Bind Id, Mode=OneWay}"
                                                    FontSize="11"
                                                    Opacity="0.68"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0,10,0,8"
                                            Text="{x:Bind DescriptionDisplay, Mode=OneWay}"
                                            FontSize="12"
                                            MaxLines="3"
                                            TextWrapping="WrapWholeWords"
                                            TextTrimming="WordEllipsis" />

                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <Button
                                                Content="Details"
                                                Click="DetailsButton_Click"
                                                Tag="{x:Bind}" />
                                            <Button
                                                Grid.Column="1"
                                                Click="AddToQueueButton_Click"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Ajouter a la file">
                                                <SymbolIcon Symbol="Add" />
                                            </Button>
                                            <Button
                                                Grid.Column="2"
                                                Click="InstallButton_Click"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Installer maintenant">
                                                <SymbolIcon Symbol="Download" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBox
            Grid.Row="3"
            Margin="8,18,8,0"
            Text="{x:Bind ViewModel.OperationLog, Mode=OneWay}"
            AcceptsReturn="True"
            FontFamily="Consolas"
            IsReadOnly="True"
            MinHeight="140"
            TextWrapping="NoWrap"
            Visibility="{x:Bind ViewModel.HasLog, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</Page>
