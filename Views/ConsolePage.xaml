<Page
    x:Class="GetGUI.Views.ConsolePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32" RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="Console" FontSize="30" FontWeight="SemiBold" />
                <TextBlock
                    Text="{x:Bind ViewModel.LogPath, Mode=OneWay}"
                    Opacity="0.72"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <CommandBar Grid.Column="1" DefaultLabelPosition="Right">
                <AppBarButton Icon="Refresh" Label="Actualiser" Click="RefreshButton_Click" />
                <AppBarButton Icon="Delete" Label="Effacer" Click="ClearButton_Click" />
            </CommandBar>
        </Grid>

        <InfoBar
            Grid.Row="1"
            Margin="0,12,0,14"
            IsOpen="True"
            Severity="Informational"
            Message="Les logs sont conserves entre les lancements, sauf si l'option de vidage a la fermeture est activee." />

        <TextBox
            x:Name="LogBox"
            Grid.Row="2"
            Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
            AcceptsReturn="True"
            FontFamily="Consolas"
            FontSize="12"
            IsReadOnly="True"
            TextWrapping="NoWrap" />
    </Grid>
</Page>
